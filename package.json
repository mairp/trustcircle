{
  "name": "trustcircle",
  "version": "0.1.0",
  "private": true,
  "description": "TrustCircleAI Governance Control Plane — vendor-neutral, brownfield governance control plane monorepo (spec 001-governance-control-plane).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*",
    "apps/*",
    "adapters/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --build --verbose",
    "contracts:validate": "node --experimental-strip-types packages/contracts/scripts/validate.ts",
    "contracts:generate": "node --experimental-strip-types packages/contracts/scripts/generate.ts",
    "contracts:check": "node --experimental-strip-types packages/contracts/scripts/generate.ts --check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:migrations": "vitest run --project migration",
    "test:resilience": "vitest run --project resilience",
    "test:recovery": "vitest run --project recovery",
    "test:e2e": "playwright test",
    "test:e2e:discovery": "TC_NO_WEBSERVER=1 playwright test --project=discovery",
    "test:accessibility": "playwright test --project=accessibility",
    "test:performance": "node --experimental-strip-types tests/performance/config.ts",
    "test:performance:acceptance": "node --experimental-strip-types tests/performance/acceptance.ts",
    "test:performance:vitest": "vitest run --project performance",
    "test:boundaries": "node --test \"tests/boundaries/**/*.test.mjs\"",
    "test:evidence": "node --experimental-strip-types --test \"tests/evidence/**/*.test.mjs\"",
    "test:sod": "node --experimental-strip-types --test \"tests/authz/**/*.test.mjs\"",
    "test:policy": "node --experimental-strip-types --test \"tests/policy/**/*.test.mjs\"",
    "test:domain": "node --experimental-strip-types --test \"tests/domain/**/*.test.mjs\"",
    "test:audit-ledger": "node --experimental-strip-types --test \"tests/audit-ledger/**/*.test.mjs\"",
    "test:tooling": "node --experimental-strip-types --test-concurrency=1 --test \"tests/tooling/**/*.test.mjs\"",
    "test:persistence": "node --experimental-strip-types --test \"tests/persistence/**/*.test.mjs\"",
    "test:application": "node --experimental-strip-types --test \"tests/application/**/*.test.mjs\"",
    "test:worker": "node --experimental-strip-types --test \"tests/worker/**/*.test.mjs\"",
    "test:projector": "node --experimental-strip-types --test \"tests/projector/**/*.test.mjs\"",
    "test:discovery": "node --experimental-strip-types --test \"tests/discovery/**/*.test.mjs\"",
    "db:migrate": "node --import tsx packages/persistence/src/database.ts migrate",
    "fixtures:seed": "node --import tsx tests/fixtures/seed.ts",
    "health": "node --import tsx apps/api/src/health-check.ts",
    "ci:contracts": "node scripts/ci/run-if-present.mjs --label contracts --requires packages/contracts/scripts/validate.ts -- npm run contracts:validate",
    "ci:contracts:generated": "node scripts/ci/run-if-present.mjs --label generated-code --requires packages/contracts/scripts/generate.ts -- npm run contracts:check",
    "ci:migrations": "node scripts/ci/run-if-present.mjs --label migrations --requires packages/persistence/src/database.ts -- npm run test:migrations",
    "evidence:manifest": "node scripts/ci/evidence-manifest.mjs build",
    "evidence:verify": "node scripts/ci/evidence-manifest.mjs verify",
    "verify:manifests": "node --experimental-strip-types tests/evidence/verify-manifests.ts",
    "contracts:publish": "node --experimental-strip-types packages/contracts/src/publish.ts",
    "supply-chain:evidence": "node --experimental-strip-types scripts/supply-chain-evidence.ts",
    "verify:release:gate": "node --experimental-strip-types scripts/verify-release.ts",
    "test:audit-readiness": "node --test \"tests/fixtures/audit-readiness/validate.mjs\" \"tests/evidence/audit-readiness/validate.mjs\"",
    "validate:full-quickstart": "node --experimental-strip-types scripts/full-quickstart.ts",
    "release:approval": "node --experimental-strip-types scripts/release-approval.ts",
    "verify:release": "npm run contracts:validate && npm run contracts:check && npm run lint && npm run format && npm run typecheck && npm run test:unit && npm run test:contract && npm run test:integration && npm run test:boundaries && npm run test:evidence && npm run test:sod && npm run test:policy && npm run test:domain && npm run test:audit-ledger && npm run test:application && npm run test:tooling",
    "verify:pr": "npm run ci:contracts && npm run ci:contracts:generated && npm run lint && npm run format && npm run typecheck && npm run test:unit && npm run test:contract && npm run test:integration && npm run test:security && npm run test:resilience && npm run test:boundaries && npm run test:evidence && npm run test:sod && npm run test:policy && npm run test:domain && npm run test:audit-ledger && npm run test:application && npm run test:worker && npm run test:projector && npm run test:discovery && npm run test:tooling && npm run test:persistence && npm run ci:migrations && npm run evidence:verify"
  },
  "dependencies": {
    "js-yaml": "4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
