# Prettier exclusions — must mirror the generated-file / build-output ignores in
# eslint.config.mjs so both tools agree on what is machine-authored or disposable.

# Installed / disposable
node_modules/
.tsbuild/
**/*.tsbuildinfo
**/dist/
**/build/
**/.next/
apps/web/next-env.d.ts
**/coverage/
playwright-report/
test-results/

# Runtime state / tooling scratch
.lisa/
.git/
.agents/
.specify/
# Gate evidence-capture scratch: raw run logs, emitted manifest samples, and evidence
# drivers written verbatim by the test harness. These are disposable proof artifacts, not
# authored source — the formatter must not own them (mirrors test-results/ above). They stay
# tracked/non-git-ignored so gate grounding snapshots can read them.
tests/e2e/scenarios/_evidence/
tests/tooling/_evidence/

# Generated, signed release-evidence artifacts (Phase 9 / GAR-010): full-quickstart validation
# manifest and release approval manifest, emitted verbatim by their generator scripts and pinned
# by digest/signature. Reformatting would break signature reproducibility. Mirrors eslint.config.mjs.
# The canonical single-line audit-readiness manifest is likewise generated.
artifacts/
tests/fixtures/audit-readiness/manifest.json
# Grounding-visible mirror of the same generated single-line audit-readiness manifest.
tests/evidence/audit-readiness/manifest.json

# Lockfile (npm owns its formatting)
package-lock.json

# Generated contract types (produced by `npm run contracts:generate`)
packages/contracts/src/generated/
**/*.gen.ts
**/*.generated.ts

# Authored specification & test-plan documents — canonical source-of-truth prose and
# hand-maintained contract fixtures. Reformatting these would churn approved content and,
# for the contract fixtures, could alter a supported source contract (GAR-010). Owned by
# their authors, not by the formatter.
specs/
testautomation/
