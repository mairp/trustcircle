# Lisa runtime state
.lisa/

# Node / npm workspace install output (disposable; regenerated by `npm ci`)
node_modules/
npm-debug.log*
*.tsbuildinfo

# TypeScript project-reference build output (declarations + .tsbuildinfo).
# Disposable; regenerated by `npm run typecheck` (`tsc --build`).
.tsbuild/

# Environment / secrets — must never be committed (protects workspace state & secrets)
.env
.env.*
!.env.example

# Vitest / coverage output (disposable)
coverage/
