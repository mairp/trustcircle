# .env.example — variables consumed by scripts/provision.sh (copy to .provision/<target>.env, or
# let the script generate that file with fresh random values). Never commit a filled-in copy.
#
# PostgreSQL password for the `trustcircle` role (canonical governance store).
POSTGRES_PASSWORD=
# Object-storage (S3-compatible, MinIO) root/secret key for evidence custody.
OBJECT_STORE_SECRET_KEY=
# Full DSN used by the API, workers, projector and discovery agent. Must embed POSTGRES_PASSWORD.
DATABASE_URL=postgres://trustcircle:<POSTGRES_PASSWORD>@postgres:5432/trustcircle
